
# Environment Variables Example
# Replace with your actual values

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Book Now form delivery (api/book-now.js).
# Optional — without RESEND_API_KEY, requests are logged server-side and the
# client falls back to a mailto: link, but nothing gets lost.
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=helpdesk@rahvion.com
BOOKING_FROM_EMAIL=bookings@rahvion.com

# Stripe subscription checkout (api/create-checkout-session.js).
# Optional — without these, the Core Plan button falls back to the static
# Stripe Payment Link already live on the site.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_CORE=
